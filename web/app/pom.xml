<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.lucky.agent</groupId>
    <artifactId>lucky-agent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>lucky-agent</name>
    <description>Lucky Agent 智能体编排框架 - 多模块 Maven 工程（Phase 1 MVP）</description>

    <modules>
        <module>agent-common</module>
        <module>agent-cache</module>
        <module>agent-core</module>
        <module>agent-memory</module>
        <module>agent-workspace</module>
        <module>agent-permission</module>
        <module>agent-executor</module>
        <module>agent-model</module>
        <module>agent-persona</module>
        <module>agent-skill</module>
        <module>agent-mcp</module>
        <module>agent-web</module>
        <module>agent-cli</module>
        <module>agent-workflow</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <langchain4j.version>1.19.0</langchain4j.version>
        <langgraph4j.version>1.8.24</langgraph4j.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <guava.version>33.4.0-jre</guava.version>
        <commons-exec.version>1.4.0</commons-exec.version>
        <lombok.version>1.18.38</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-cache</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-workspace</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-permission</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-executor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-persona</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-skill</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-mcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lucky.agent</groupId>
                <artifactId>agent-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- LangChain4j（AI 编排核心：Agent/工具/记忆/RAG） -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>

            <!-- LangGraph4j（工作流 DAG 与多 Agent 图编排；Phase 4 落地实现，本阶段锁定依赖） -->
            <dependency>
                <groupId>org.bsc.langgraph4j</groupId>
                <artifactId>langgraph4j-core</artifactId>
                <version>${langgraph4j.version}</version>
            </dependency>

            <!-- Spring AI（辅助模型/向量/可观测性接入层，桥接 LangChain4j） -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 第三方 -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-exec</artifactId>
                <version>${commons-exec.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- lombok 供所有子模块使用 @Slf4j 等注解 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 关闭增量编译：避免依赖类常量变更时测试类未重编，导致 final 常量内联陈旧值（如 BasePromptStoreTest） -->
                    <useIncrementalCompilation>false</useIncrementalCompilation>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- JDK 21 下 JVM 默认拒绝 manifest classpath 中的绝对路径（surefire fork 的
                         booter/test-classes），导致 JUnit 发现测试类失败；关闭该校验（JDK 17 不受影响） -->
                    <argLine>-Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
