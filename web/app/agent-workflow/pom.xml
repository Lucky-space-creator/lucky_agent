<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lucky.agent</groupId>
        <artifactId>lucky-agent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>agent-workflow</artifactId>
    <name>agent-workflow</name>
    <description>独立工作流模块：工作流定义/配置、流程节点与步骤管理、触发与执行、状态流转与条件控制；提供节点/连接器/调度器等可复用组件，低耦合、职责单一、便于扩展。</description>

    <dependencies>
        <!-- Web 层：REST 接口 + SSE 执行监控。
             只引入 spring-web（注解）与 spring-webflux（响应式 SSE），**不引入 spring-boot-starter-web**：
             后者会带入 spring-boot-starter-tomcat + spring-webmvc，使宿主的
             WebApplicationType 被判定为 SERVLET，从而禁用 WebFlux（宿主 agent-web 为响应式栈）。
             保持本模块「web 栈无关」，交由宿主决定 Web 实现。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
        </dependency>
        <!-- 响应式事件总线（同 agent-common 生态） -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <!-- LangGraph4j：工作流 DAG 的状态图引擎（与 agent-core 同版本，见父 pom 属性） -->
        <dependency>
            <groupId>org.bsc.langgraph4j</groupId>
            <artifactId>langgraph4j-core</artifactId>
        </dependency>
        <!-- JSON 序列化（定义持久化） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 工具集（同工程约定） -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 配置属性绑定 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
